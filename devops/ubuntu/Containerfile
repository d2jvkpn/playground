FROM ubuntu:26.04

ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV http_proxy=$http_proxy \
    https_proxy=$https_proxy \
    no_proxy=$no_proxy

ENV TZ=Asia/Shanghai

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    tzdata ca-certificates locales gnupg software-properties-common \
    gosu sudo openssh-server openssl supervisor git wget curl rsync netcat-openbsd mtr \
    file tree zip unzip vim less && \
    update-ca-certificates && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 && \
    rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub && \
    rm -rf /var/lib/apt/lists/*
# build-essential podman python3 python3-venv python3-pip python3-dev libgl1 libglib2.0-0t64 fonts-noto-cjk
# locale-gen zh_CN.UTF-8

RUN (id -u ubuntu >/dev/null 2>&1 || useradd -m -s /bin/bash ubuntu) && \
    usermod -aG sudo -s /bin/bash ubuntu && \
    printf '%s\n' 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu && \
    visudo -cf /etc/sudoers.d/ubuntu

RUN mkdir -p /opt/defaults && cp -a /home/ubuntu /opt/defaults/ubuntu

RUN mkdir -p /opt/defaults/ssh && \
    for item in ssh_config ssh_config.d sshd_config sshd_config.d; do \
        if [ -e "/etc/ssh/$item" ]; then \
            cp -a "/etc/ssh/$item" /opt/defaults/ssh/; \
        fi; \
    done

COPY container/sshd-supervisor.conf /etc/supervisor/conf.d/sshd-supervisor.conf
COPY container/prepare-container.sh /opt/bin/prepare-container.sh
COPY container/entrypoint.sh /opt/bin/entrypoint.sh
RUN chmod +x /opt/bin/prepare-container.sh /opt/bin/entrypoint.sh

ENV http_proxy="" \
    https_proxy="" \
    no_proxy=""

WORKDIR /home/ubuntu
ENV HOME=/home/ubuntu
USER ubuntu

VOLUME ["/etc/ssh", "/run/ubuntu-auth"]
EXPOSE 22
CMD ["/opt/bin/entrypoint.sh"]
