# path: /opt/homebrew/etc/caddy/Caddyfile

http://omlx.localhost {
  reverse_proxy 192.168.1.42:11234 10.1.1.42:11234 {
    lb_policy        first
    health_uri       /health
    health_interval  5s
    health_timeout   2s
    lb_try_duration  5s
    fail_duration    30s
  }

  redir / /admin/ permanent
}
